{
  "name": "paseo-resume-guard",
  "private": true,
  "version": "1.0.0",
  "description": "Blocks opening (resuming) an agent whose snapshot shows status \"error\" with a context above a token threshold, telling the sender to write a handoff file and spawn a fresh agent instead.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klutzydrummer/paseo-plugins.git",
    "directory": "resume-guard"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.4",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
